{
  "ExpressEJS": {
    "prefix": "express-ejs",
    "body": [
      "const express = require('express');",
      "const path = require('path');",
      "const app = express();",
      "const PORT = 3000;",
      "",
      "app.set('view engine', 'ejs');",
      "app.set('views', path.join(__dirname, 'static'));",
      "",
      "app.use(express.static('public'));",
      "app.use(express.urlencoded({ extended: true }));",
      "",
      "app.use((req, res) => {",
      "    res.status(404).render('404');",
      "});",
      "",
      "app.get('/', (req, res) => {",
      "    res.render('index');",
      "});",
      "",
      "app.${1:get}",
      "app.listen(PORT, () => {",
      "    console.log(`Server running on port ${${PORT}}`);",
      "});"
    ],
    "description": "Express.js Server Snippets"
  },
  "Class Snippets": {
    "prefix": "class",
    "body": [
      "class ${1:ClassName} {",
      "    constructor(${2:params}) {",
      "        this.${3:property} = ${4:value};",
      "        // Initialize properties here",
      "    }",
      "",
      "    ${5:method}() {",
      "        ${6:body}",
      "        // Method implementation here",
      "    }",
      "}"
    ],
    "description": "Class Snippets",
  },
  "EventListener": {
    "prefix": "addEventListener",
    "body": [
      "${1:document}.addEventListener('${2:event}', (e) => {",
      "    ${3:body}",
      "});"
    ],
    "description": "Event Listener",
  },
  "DOMContentLoaded": {
    "prefix": "dom-load",
    "body": [
      "document.addEventListener('DOMContentLoaded', () => {",
      "    ${1:body}",
      "});"
    ],
    "description": "DOM Content Loaded Event"
  },
  "Arrow Function": {
    "prefix": "function",
    "body": [
      "const ${1:name} = () => {",
      "    ${2:body}",
      "}"
    ],
    "description": "Arrow Function"
  },
  "Async Function": {
    "prefix": "async",
    "body": [
      "const ${1:asyncFunctionName} = async () => {",
      "    ${2:body}",
      "};"
    ],
    "description": "Create an async function"
  },
  "Callback Function": {
    "prefix": "callback",
    "body": [
      "const ${1:functionName} = (${2:params},callback) => {",
      "    ${3:body}",
      "    callback(${4:result});",
      "}"
    ],
    "description": "Create a callback function"
  },
  "Anti-Hack": {
    "prefix": "anti-hack",
    "body": [
      "document.addEventListener(\"contextmenu\", (e) => {",
      "    e.preventDefault();",
      "});",
      "",
      "document.addEventListener(\"keydown\", (e) => {",
      "    if ((e.ctrlKey || e.metaKey) && e.shiftKey && e.key === \"I\") {",
      "        e.preventDefault();",
      "    }",
      "    if (e.key === \"F12\") {",
      "        e.preventDefault();",
      "        displayMessage();",
      "    }",
      "});",
      "",
      "document.addEventListener('keydown', (event) => {",
      "    if (event.ctrlKey && event.key === 'u') {",
      "        event.preventDefault();",
      "    }",
      "});",
      "",
      "var message = [\"%cHack CC\", \"%cTắt đi ngay!\"];",
      "var index = 0;",
      "var lineIndex = 0;",
      "",
      "function displayMessage() {",
      "    console.clear();",
      "    for (var i = 0; i < lineIndex; i++) {",
      "        console.log(",
      "            message[i],",
      "            \"color: red; font-weight: bold; font-size: 50px; background-color: yellow;\"",
      "        );",
      "    }",
      "    var currentLine = message[lineIndex].substring(0, index);",
      "    console.log(",
      "        currentLine,",
      "        \"color: red; font-weight: bold; font-size: 50px; background-color: yellow;\"",
      "    );",
      "    index++;",
      "    if (index > message[lineIndex].length) {",
      "        index = 0;",
      "        lineIndex++;",
      "        if (lineIndex >= message.length) {",
      "            lineIndex = 0;",
      "        }",
      "    }",
      "}",
      "",
      "document.addEventListener(\"copy\", (e) => {",
      "    e.preventDefault();",
      "});",
      "",
      "document.addEventListener(\"cut\", (e) => {",
      "    e.preventDefault();",
      "});",
      "",
      "function openDebugger() {",
      "    debugger;",
      "}",
      "setInterval(displayMessage, 50);",
      "setInterval(openDebugger, 50);"
    ],
    "description": "Anti-Hack"
  }
}