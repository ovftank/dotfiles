{
    "Nginx Flask": {
        "prefix": "nginx-flask",
        "body": [
            "server {",
            "    listen 80;",
            "    server_name ${1:_};",
            "",
            "    location / {",
            "        proxy_pass http://localhost:5000;",
            "        proxy_http_version 1.1;",
            "        proxy_set_header Upgrade $${2:}http_upgrade;",
            "        proxy_set_header Connection 'upgrade';",
            "        proxy_set_header Host $${2:}host;",
            "        proxy_cache_bypass $${2:}http_upgrade;",
            "    }",
            "}"
        ],
        "description": "Nginx configuration for Flask"
    },
    "Nginx Express": {
        "prefix": "nginx-express",
        "body": [
            "server {",
            "    listen 80;",
            "    server_name ${1:_};",
            "",
            "    location / {",
            "        proxy_pass http://localhost:3000;",
            "        proxy_http_version 1.1;",
            "        proxy_set_header Upgrade $$http_upgrade;",
            "        proxy_set_header Connection 'upgrade';",
            "        proxy_set_header Host $$host;",
            "        proxy_cache_bypass $$http_upgrade;",
            "    }",
            "}"
        ],
        "description": "Nginx configuration for Express.js"
    }
}
