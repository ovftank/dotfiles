{
	"Set Up Nginx Server Configuration": {
		"prefix": "nginx-config",
		"body": [
			"# Nginx configuration",
			"sudo apt-get install nginx -y",
			"sudo cp ./${1:default} /etc/nginx/sites-available/default",
			"ln -s /etc/nginx/sites-available/default /etc/nginx/sites-enabled/default",
			"sudo systemctl restart nginx"
		],
		"description": "Install and configure Nginx server"
	},
	"Config pip": {
		"prefix": "pip-config",
		"body": [
			"# Config pip",
			"mkdir -p ~/.config/pip/",
			"rm -f ~/.config/pip/pip.conf",
			"cat <<EOF > ~/.config/pip/pip.conf",
			"[global]",
			"break-system-packages = true",
			"EOF",
			"echo 'export PATH=\"$$HOME/.local/bin:$$PATH\"' >> \"$$HOME/.bashrc\"",
			"source \"$$HOME/.bashrc\""
		],
		"description": "Config pip"
	},
	"Update && upgrade": {
		"prefix": "update",
		"body": [
			"# Update && upgrade",
			"sudo apt update && sudo apt upgrade -y && sudo apt --fix-broken install && sudo apt autoremove --purge"
		],
		"description": "Update && upgrade"
	},
	"Install dependencies for Selenium": {
		"prefix": "chrome-selenium",
		"body": [
			"sudo apt install python3 ca-certificates fonts-liberation libasound2 libatk-bridge2.0-0 libatk1.0-0 libc6 libcairo2 libcups2 libdbus-1-3 libexpat1 libfontconfig1 libgbm1 libgcc1 libglib2.0-0 libgtk-3-0 libnspr4 libnss3 libpango-1.0-0 libpangocairo-1.0-0 libstdc++6 libx11-6 libx11-xcb1 libxcb1 libxcomposite1 libxcursor1 libxdamage1 libxext6 libxfixes3 libxi6 libxrandr2 libxrender1 libxss1 libxtst6 lsb-release wget xdg-utils --fix-missing -y",
			"wget https://bootstrap.pypa.io/get-pip.py",
			"sudo python3 get-pip.py",
			"wget https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb",
			"curl -s https://googlechromelabs.github.io/chrome-for-testing/ > temp.html",
			"chromedriver_url=$(grep -oE 'https://storage.googleapis.com/chrome-for-testing-public/[0-9.]+/linux64/chromedriver-linux64.zip' temp.html | head -n 1)",
			"curl -o chromedriver_linux64.zip $$chromedriver_url",
			"unzip chromedriver_linux64.zip",
			"sudo mv chromedriver-linux64/chromedriver /usr/local/bin/chromedriver",
			"sudo chmod +x /usr/local/bin/chromedriver",
			"sudo dpkg -i google-chrome-stable_current_amd64.deb",
			"rm -rf ./*chrome*",
			"sudo pip install selenium"
		],
		"description": "Install necessary dependencies for Selenium including Chrome browser and Chromedriver"
	}
}