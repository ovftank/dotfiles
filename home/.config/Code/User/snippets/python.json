{
	"Flask app template": {
		"prefix": "flaskapp",
		"body": [
			"from flask import Flask, jsonify, request, send_from_directory",
			"from flask_cors import CORS",
			"",
			"app = Flask(__name__, static_url_path='', static_folder='${1:static}')",
			"CORS(app, resources={r'/*': {'origins': '${2:*}'}}) if ${3:True} else None",
			"",
			"@app.route('/', methods=['GET'])",
			"def index():",
			"    return send_from_directory(app.static_folder, 'index.html')",
			"",
			"@app.errorhandler(404)",
			"def not_found_error(error):",
			"    # return send_from_directory(app.static_folder, '404.html')",
			"    return jsonify({'error': 'Not found'}), 404",
			"",
			"${4:#Enter your code}",
			"if __name__ == '__main__':",
			"    app.run(host='0.0.0.0', port=${5:5000})"
		],
		"description": "Flask cors template"
	},
