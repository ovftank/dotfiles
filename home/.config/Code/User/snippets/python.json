	"Requests without Session": {
		"prefix": "requests",
		"body": [
			"import requests",
			"",
			"url = '${1:url}'",
			"params = {${2:params}}",
			"headers = {${3:headers}}",
			"",
			"response = requests.${4:get}('url', params=params, headers=headers)",
			"data = response.json()",
			"print(data)"
		],
		"description": "Make a request without session using requests library in Python"
	},
	"Requests with Session": {
		"prefix": "requests-session",
		"body": [
			"import requests",
			"",
			"url = '${1:url}'",
			"params = {${2:params}}",
			"headers = {${3:headers}}",
			"",
			"with requests.Session() as session:",
			"    response = session.${4:get}('url', params=params, headers=headers)",
			"    data = response.json()",
			"    print(data)"
		],
		"description": "Make a request with session using requests library in Python"
	}
