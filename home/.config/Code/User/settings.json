{
    "[css]": {
        "editor.defaultFormatter": "vscode.css-language-features"
    },
    "[html]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[ignore]": {
        "editor.defaultFormatter": "foxundermoon.shell-format"
    },
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.showUnused": true
    },
    "[javascriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[jinja-html]": {
        "editor.defaultFormatter": "vscode.html-language-features"
    },
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[markdown]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[python]": {
        "editor.defaultFormatter": "ms-python.autopep8"
    },
    "[snippets]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "auto-rename-tag.activationOnLanguage": [
        "*"
    ],
    "autoDocstring.logLevel": "Debug",
    "autoDocstring.startOnNewLine": true,
    "cSpell.enableFiletypes": [
        "Log",
        "dockerfile",
        "dotenv",
        "ignore",
        "ini",
        "jinja",
        "jinja-css",
        "jinja-html",
        "jsonl",
        "jsx-tags",
        "log",
        "markdown-math",
        "powershell",
        "properties",
        "shellscript",
        "snippets",
        "sql",
        "sqlite3-editor-database",
        "tailwindcss",
        "toml",
        "xml"
    ],
    "cSpell.language": "en,vi",
    "cSpell.userWords": [
        "alacritty",
        "codeium",
        "dont't",
        "liveshare",
        "openai",
        "prefs",
        "Pylance",
        "singlequotes",
        "tailwindcss",
        "vsicons",
        "wakatime"
    ],
    "codeium.enableCodeLens": false,
    "codeium.enableConfig": {
        "*": true,
        "bat": true,
        "dotenv": true,
        "ejs": true,
        "ignore": true,
        "jinja": true,
        "jinja-html": true,
        "jinja-js": true,
        "markdown": true,
        "nginx": true,
        "pip-requirements": true,
        "plaintext": true,
        "properties": true,
        "query-editor": true,
        "restructuredtext": true,
        "snippets": true,
        "sqlite": true,
        "sqlite3-editor-database": true,
        "tailwindcss": true
    },
    "css.lint.duplicateProperties": "warning",
    "css.lint.idSelector": "warning",
    "css.lint.unknownAtRules": "ignore",
    "css.validate": true,
    "debug.allowBreakpointsEverywhere": true,
    "editor.accessibilitySupport": "off",
    "editor.autoIndent": "none",
    "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
    "editor.codeActionsOnSave": {
        "addMissingImports": "always",
        "source.organizeImports": "always"
    },
    "editor.codeLensFontFamily": "'JetBrainsMono Nerd Font', 'JetBrainsMono Nerd Font Mono', 'JetBrainsMono'",
    "editor.comments.ignoreEmptyLines": true,
    "editor.cursorBlinking": "solid",
    "editor.defaultColorDecorators": true,
    "editor.definitionLinkOpensInPeek": false,
    "editor.experimental.asyncTokenization": true,
    "editor.fastScrollSensitivity": 2,
    "editor.find.addExtraSpaceOnTop": true,
    "editor.folding": true,
    "editor.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrainsMono Nerd Font Mono', 'JetBrainsMono'",
    "editor.fontLigatures": true,
    "editor.fontSize": 14,
    "editor.formatOnSave": true,
    "editor.glyphMargin": true,
    "editor.gotoLocation.alternativeDeclarationCommand": "editor.action.goToReferences",
    "editor.guides.bracketPairs": "active",
    "editor.indentSize": "tabSize",
    "editor.inlayHints.enabled": "on",
    "editor.inlayHints.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrainsMono Nerd Font Mono', 'JetBrainsMono'",
    "editor.inlayHints.padding": true,
    "editor.inlineCompletionsAccessibilityVerbose": true,
    "editor.inlineSuggest.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrainsMono Nerd Font Mono', 'JetBrainsMono'",
    "editor.inlineSuggest.suppressSuggestions": true,
    "editor.lineHeight": 1.4,
    "editor.minimap.enabled": false,
    "editor.mouseWheelScrollSensitivity": 2,
    "editor.multiCursorPaste": "full",
    "editor.quickSuggestions": {
        "strings": "on"
    },
    "editor.renderWhitespace": "boundary",
    "editor.showDeprecated": true,
    "editor.showFoldingControls": "always",
    "editor.stickyScroll.enabled": true,
    "editor.suggest.showWords": false,
    "editor.suggestSelection": "recentlyUsed",
    "editor.wordWrap": "bounded",
    "editor.wordWrapColumn": 100,
    "emmet.includeLanguages": {
        "ejs": "html",
        "javascript": "html",
        "jinja": "html",
        "jinja-html": "html",
        "php": "html",
        "typescript": "html"
    },
    "emmet.showSuggestionsAsSnippets": true,
    "errorLens.codeLensTemplate": "$count $severity $message $code",
    "errorLens.delayMode": "debounce",
    "errorLens.fontFamily": "JetBrains Mono",
    "errorLens.gutterIconsEnabled": true,
    "errorLens.messageTemplate": "$count $message $severity",
    "errorLens.searchForProblemQuery": "https://www.phind.com/search?q=$message",
    "errorLens.statusBarColorsEnabled": true,
    "errorLens.statusBarMessageEnabled": true,
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "explorer.confirmPasteNative": false,
    "explorer.excludeGitIgnore": true,
    "files.associations": {
        "*.css": "tailwindcss",
        "*.html": "jinja-html",
        "*.sql": "sql"
    },
    "files.autoGuessEncoding": true,
    "files.autoSave": "onWindowChange",
    "files.autoSaveWhenNoErrors": true,
    "files.enableTrash": false,
    "files.eol": "\n",
    "files.exclude": {
        "**/.DS_Store": true,
        "**/.git": true,
        "**/build": true,
        "**/node_modules": true,
        "**/package-lock.json": true
    },
    "files.hotExit": "off",
    "files.saveConflictResolution": "overwriteFileOnDisk",
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    "files.watcherExclude": {
        "**/node_modules/**": true
    },
    "gitlens.ai.experimental.anthropic.model": "claude-3-sonnet-20240229",
    "gitlens.ai.experimental.gemini.model": "gemini-1.5-pro-latest",
    "gitlens.ai.experimental.openai.model": "gpt-3.5-turbo",
    "gitlens.ai.experimental.provider": "anthropic",
    "gitlens.showWelcomeOnInstall": false,
    "gitlens.views.commitDetails.files.layout": "list",
    "html.completion.attributeDefaultValue": "singlequotes",
    "html.format.indentHandlebars": true,
    "html.format.indentInnerHtml": true,
    "html.format.templating": true,
    "html.suggest.html5": true,
    "isort.check": true,
    "javascript.format.enable": true,
    "javascript.format.semicolons": "insert",
    "javascript.inlayHints.enumMemberValues.enabled": true,
    "javascript.inlayHints.functionLikeReturnTypes.enabled": true,
    "javascript.inlayHints.parameterNames.enabled": "all",
    "javascript.inlayHints.parameterNames.suppressWhenArgumentMatchesName": true,
    "javascript.inlayHints.parameterTypes.enabled": true,
    "javascript.inlayHints.propertyDeclarationTypes.enabled": true,
    "javascript.inlayHints.variableTypes.enabled": true,
    "javascript.inlayHints.variableTypes.suppressWhenTypeMatchesName": true,
    "javascript.preferGoToSourceDefinition": true,
    "javascript.suggest.autoImports": true,
    "javascript.suggest.completeFunctionCalls": true,
    "javascript.suggestionActions.enabled": true,
    "javascript.updateImportsOnFileMove.enabled": "always",
    "livePreview.customExternalBrowser": "Chrome",
    "livePreview.debugOnExternalPreview": true,
    "livePreview.hostIP": "0.0.0.0",
    "livePreview.httpHeaders": {
        "Accept-Ranges": "bytes",
        "Access-Control-Allow-Origin": "*"
    },
    "liveshare.accessibility.soundsEnabled": false,
    "mediaPreview.video.autoPlay": true,
    "path-intellisense.absolutePathToWorkspace": true,
    "path-intellisense.autoSlashAfterDirectory": true,
    "path-intellisense.autoTriggerNextSuggestion": true,
    "path-intellisense.extensionOnImport": true,
    "prettier.jsxSingleQuote": true,
    "prettier.trailingComma": "all",
    "prettier.useTabs": true,
    "prettier.vueIndentScriptAndStyle": true,
    "prettier.withNodeModules": true,
    "problems.showCurrentInStatus": true,
    "python.analysis.autoFormatStrings": true,
    "python.analysis.autoImportCompletions": true,
    "python.analysis.completeFunctionParens": true,
    "python.analysis.fixAll": [
        "source.unusedImports",
        "source.convertImportFormat"
    ],
    "python.analysis.inlayHints.callArgumentNames": "all",
    "python.analysis.inlayHints.functionReturnTypes": true,
    "python.analysis.inlayHints.pytestParameters": true,
    "python.analysis.inlayHints.variableTypes": true,
    "python.languageServer": "Pylance",
    "python.missingPackage.severity": "Warning",
    "python.testing.debugPort": 4000,
    "pythonIndent.trimLinesWithOnlyWhitespace": true,
    "references.preferredLocation": "view",
    "search.showLineNumbers": true,
    "security.workspace.trust.banner": "never",
    "security.workspace.trust.startupPrompt": "never",
    "security.workspace.trust.untrustedFiles": "open",
    "sortJSON.contextMenu": {
        "sortJSONAlphaNum": false,
        "sortJSONAlphaNumReverse": false,
        "sortJSONKeyLength": false,
        "sortJSONKeyLengthReverse": false,
        "sortJSONReverse": false,
        "sortJSONType": false,
        "sortJSONTypeReverse": false,
        "sortJSONValues": false,
        "sortJSONValuesReverse": false
    },
    "sqlite3-editor.completion.functionCase": "upper",
    "sqlite3-editor.ui.displayLanguage": "en",
    "sqlite3-editor.ui.minimizePanel": true,
    "sqlite3-editor.ui.movePanelIfSpaceAllows": "bottom",
    "tailwindCSS.classAttributes": [
        "class",
        "className",
        "ngClass",
        "ngClassName",
        "ngStyle"
    ],
    "tailwindCSS.emmetCompletions": true,
    "tailwindCSS.experimental.classRegex": [
        "\\.classList\\.add\\(\\s*\"([^\"]+?)\"\\s*\\)",
        "\\.classList\\.remove\\(\\s*\"([^\"]+?)\"\\s*\\)",
        "\\.classList\\.add\\(\\s*'([^']+?)'\\s*\\)",
        "\\.classList\\.remove\\(\\s*'([^']+?)'\\s*\\)"
    ],
    "tailwindCSS.includeLanguages": {
        "jinja": "html",
        "jinja-html": "html"
    },
    "terminal.explorerKind": "external",
    "terminal.external.linuxExec": "alacritty",
    "terminal.external.windowsExec": "",
    "terminal.integrated.allowChords": false,
    "terminal.integrated.autoReplies": {
        "Terminate batch job (Y/N)": "Y\r"
    },
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.defaultProfile.linux": "zsh",
    "terminal.integrated.ignoreProcessNames": [
        "zsh"
    ],
    "terminal.integrated.localEchoExcludePrograms": [
        "vim"
    ],
    "terminal.integrated.rightClickBehavior": "paste",
    "terminal.sourceControlRepositoriesKind": "external",
    "typescript.format.semicolons": "insert",
    "typescript.inlayHints.enumMemberValues.enabled": true,
    "typescript.inlayHints.functionLikeReturnTypes.enabled": true,
    "typescript.inlayHints.parameterNames.enabled": "all",
    "typescript.inlayHints.parameterNames.suppressWhenArgumentMatchesName": true,
    "typescript.inlayHints.parameterTypes.enabled": true,
    "typescript.inlayHints.propertyDeclarationTypes.enabled": true,
    "typescript.inlayHints.variableTypes.enabled": true,
    "typescript.inlayHints.variableTypes.suppressWhenTypeMatchesName": true,
    "vsicons.associations.files": [
        {
            "extensions": [
                "sqlite",
                "sql",
                "query-editor"
            ],
            "format": "svg",
            "icon": "sql",
            "overrides": "query-editor"
        }
    ],
    "vsicons.presets.tsOfficial": true,
    "window.autoDetectHighContrast": false,
    "window.customMenuBarAltFocus": false,
    "window.customTitleBarVisibility": "auto",
    "window.enableMenuBarMnemonics": false,
    "window.menuBarVisibility": "hidden",
    "window.newWindowDimensions": "maximized",
    "window.title": "${dirty}${separator}${rootName}${separator}${appName}",
    "window.zoomLevel": 1.2,
    "workbench.activityBar.location": "top",
    "workbench.colorTheme": "Dracula",
    "workbench.commandPalette.experimental.suggestCommands": true,
    "workbench.editor.defaultBinaryEditor": "default",
    "workbench.editorAssociations": {
        "*.db": "sqlite3-editor.editor"
    },
    "workbench.iconTheme": "vscode-icons",
    "workbench.preferredDarkColorTheme": "Dracula",
    "workbench.preferredHighContrastColorTheme": "Dracula",
    "workbench.preferredHighContrastLightColorTheme": "Dracula",
    "workbench.preferredLightColorTheme": "Dracula",
    "workbench.settings.applyToAllProfiles": [
        "editor.fontSize",
        "workbench.iconTheme",
        "editor.fontFamily",
        "files.autoSave",
        "files.exclude",
        "editor.fastScrollSensitivity"
    ],
    "workbench.startupEditor": "none",
    "workbench.tree.indent": 4,
    "workbench.welcomePage.walkthroughs.openOnInstall": false
}