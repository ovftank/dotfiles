n\\\": \\\"Express.js Server Snippets\\\"\\n  },\\n  \\\"Class Snippets\\\": {\\n    \\\"prefix\\\": \\\"class\\\",\\n    \\\"body\\\": [\\n      \\\"class ${1:ClassName} {\\\",\\n      \\\"    constructor(${2:params}) {\\\",\\n      \\\"        this.${3:property} = ${4:value};\\\",\\n      \\\"        // Initialize properties here\\\",\\n      \\\"    }\\\",\\n      \\\"\\\",\\n      \\\"    ${5:method}() {\\\",\\n      \\\"        ${6:body}\\\",\\n      \\\"        // Method implementation here\\\",\\n      \\\"    }\\\",\\n      \\\"}\\\"\\n    ],\\n    \\\"description\\\": \\\"Class Snippets\\\",\\n  },\\n  \\\"EventListener\\\": {\\n    \\\"prefix\\\": \\\"addEventListener\\\",\\n    \\\"body\\\": [\\n      \\\"${1:document}.addEventListener('${2:event}', (e) => {\\\",\\n      \\\"    ${3:body}\\\",\\n      \\\"});\\\"\\n    ],\\n    \\\"description\\\": \\\"Event Listener\\\",\\n  },\\n  \\\"DOMContentLoaded\\\": {\\n    \\\"prefix\\\": \\\"dom-load\\\",\\n    \\\"body\\\": [\\n      \\\"document.addEventListener('DOMContentLoaded', () => {\\\",\\n      \\\"    ${1:body}\\\",\\n      \\\"});\\\"\\n    ],\\n    \\\"description\\\": \\\"DOM Content Loaded Event\\\"\\n  },\\n  \\\"Arrow Function\\\": {\\n    \\\"prefix\\\": \\\"function\\\",\\n    \\\"body\\\": [\\n      \\\"const ${1:name} = () => {\\\",\\n      \\\"    ${2:body}\\\",\\n      \\\"}\\\"\\n    ],\\n    \\\"description\\\": \\\"Arrow Function\\\"\\n  },\\n  \\\"Async Function\\\": {\\n    \\\"prefix\\\": \\\"async\\\",\\n    \\\"body\\\": [\\n      \\\"const ${1:asyncFunctionName} = async () => {\\\",\\n      \\\"    ${2:body}\\\",\\n      \\\"};\\\"\\n    ],\\n    \\\"description\\\": \\\"Create an async function\\\"\\n  },\\n  \\\"Callback Function\\\": {\\n    \\\"prefix\\\": \\\"callback\\\",\\n    \\\"body\\\": [\\n      \\\"const ${1:functionName} = (${2:params},callback) => {\\\",\\n      \\\"    ${3:body}\\\",\\n      \\\"    callback(${4:result});\\\",\\n      \\\"}\\\"\\n    ],\\n    \\\"description\\\": \\\"Create a callback function\\\"\\n  },\\n  \\\"Anti-Hack\\\": {\\n    \\\"prefix\\\": \\\"anti-hack\\\",\\n    \\\"body\\\": [\\n      \\\"document.addEventListener(\\\\\\\"contextmenu\\\\\\\", (e) => {\\\",\\n      \\\"    e.preventDefault();\\\",\\n      \\\"});\\\",\\n      \\\"\\\",\\n      \\\"document.addEventListener(\\\\\\\"keydown\\\\\\\", (e) => {\\\",\\n      \\\"    if ((e.ctrlKey || e.metaKey) && e.shiftKey && e.key === \\\\\\\"I\\\\\\\") {\\\",\\n      \\\"        e.preventDefault();\\\",\\n      \\\"    }\\\",\\n      \\\"    if (e.key === \\\\\\\"F12\\\\\\\") {\\\",\\n      \\\"        e.preventDefault();\\\",\\n      \\\"        displayMessage();\\\",\\n      \\\"    }\\\",\\n      \\\"});\\\",\\n      \\\"\\\",\\n      \\\"document.addEventListener('keydown', (event) => {\\\",\\n      \\\"    if (event.ctrlKey && event.key === 'u') {\\\",\\n      \\\"        event.preventDefault();\\\",\\n      \\\"    }\\\",\\n      \\\"});\\\",\\n      \\\"\\\",\\n      \\\"var message = [\\\\\\\"%cHack CC\\\\\\\", \\\\\\\"%cTắt đi ngay!\\\\\\\"];\\\",\\n      \\\"var index = 0;\\\",\\n      \\\"var lineIndex = 0;\\\",\\n      \\\"\\\",\\n      \\\"function displayMessage() {\\\",\\n      \\\"    console.clear();\\\",\\n      \\\"    for (var i = 0; i < lineIndex; i++) {\\\",\\n      \\\"        console.log(\\\",\\n      \\\"            message[i],\\\",\\n      \\\"            \\\\\\\"color: red; font-weight: bold; font-size: 50px; background-color: yellow;\\\\\\\"\\\",\\n      \\\"        );\\\",\\n      \\\"    }\\\",\\n      \\\"    var currentLine = message[lineIndex].substring(0, index);\\\",\\n      \\\"    console.log(\\\",\\n      \\\"        currentLine,\\\",\\n      \\\"        \\\\\\\"color: red; font-weight: bold; font-size: 50px; background-color: yellow;\\\\\\\"\\\",\\n      \\\"    );\\\",\\n      \\\"    index++;\\\",\\n      \\\"    if (index > message[lineIndex].length) {\\\",\\n      \\\"        index = 0;\\\",\\n      \\\"        lineIndex++;\\\",\\n      \\\"        if (lineIndex >= message.length) {\\\",\\n      \\\"            lineIndex = 0;\\\",\\n      \\\"        }\\\",\\n      \\\"    }\\\",\\n      \\\"}\\\",\\n      \\\"\\\",\\n      \\\"document.addEventListener(\\\\\\\"copy\\\\\\\", (e) => {\\\",\\n      \\\"    e.preventDefault();\\\",\\n      \\\"});\\\",\\n      \\\"\\\",\\n      \\\"document.addEventListener(\\\\\\\"cut\\\\\\\", (e) => {\\\",\\n      \\\"    e.preventDefault();\\\",\\n      \\\"});\\\",\\n      \\\"\\\",\\n      \\\"function openDebugger() {\\\",\\n      \\\"    debugger;\\\",\\n      \\\"}\\\",\\n      \\\"setInterval(displayMessage, 50);\\\",\\n      \\\"setInterval(openDebugger, 50);\\\"\\n    ],\\n    \\\"description\\\": \\\"Anti-Hack\\\"\\n  }\\n}\",\"plaintext.json\":\"{\\n    \\\"Nginx Flask\\\": {\\n        \\\"prefix\\\": \\\"nginx-flask\\\",\\n        \\\"body\\\": [\\n            \\\"server {\\\",\\n            \\\"    listen 80;\\\",\\n            \\\"    server_name ${1:_};\\\",\\n            \\\"\\\",\\n            \\\"    location / {\\\",\\n            \\\"        proxy_pass http://localhost:5000;\\\",\\n            \\\"        proxy_http_version 1.1;\\\",\\n            \\\"        proxy_set_header Upgrade $${2:}http_upgrade;\\\",\\n            \\\"        proxy_set_header Connection 'upgrade';\\\",\\n            \\\"        proxy_set_header Host $${2:}host;\\\",\\n            \\\"        proxy_cache_bypass $${2:}http_upgrade;\\\",\\n            \\\"    }\\\",\\n            \\\"}\\\"\\n        ],\\n        \\\"description\\\": \\\"Nginx configuration for Flask\\\"\\n    },\\n    \\\"Nginx Express\\\": {\\n        \\\"prefix\\\": \\\"nginx-express\\\",\\n        \\\"body\\\": [\\n            \\\"server {\\\",\\n            \\\"    listen 80;\\\",\\n            \\\"    server_name ${1:_};\\\",\\n            \\\"\\\",\\n            \\\"    location / {\\\",\\n            \\\"        proxy_pass http://localhost:3000;\\\",\\n            \\\"